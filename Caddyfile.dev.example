# Dev edge for `docker compose up`. Copy to `Caddyfile` (gitignored):
#   cp Caddyfile.dev.example Caddyfile
#
# Use Caddyfile.example instead when running docker-compose-prod.yml, where the
# frontend is a built bundle served by nginx on :80 rather than Vite on :5173.

:8080 {
    encode gzip

    # --- API (HTTP) --- rest_api sets root_path=/api, so strip the prefix here
    handle_path /api/* {
        reverse_proxy rest_api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # --- WebSocket endpoint --- ws_gateway serves the socket on "/"
    handle_path /ws* {
        reverse_proxy ws_gateway:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # --- Voice signalling --- LiveKit's websocket + HTTP API, same origin as
    # the app so the browser needs no separate host. Media does NOT come
    # through here: it is WebRTC over UDP straight to :7882 on the host.
    handle_path /livekit/* {
        reverse_proxy livekit:7880 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # --- Everything else -> Vite dev server (also carries HMR over websocket) ---
    handle /* {
        reverse_proxy frontend:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
