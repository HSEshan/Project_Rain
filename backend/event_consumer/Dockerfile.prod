FROM python:3.12.4-slim AS base

WORKDIR /app

# Install build deps and runtime libs
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install shared libs first (caches better)
COPY ./libs /app/libs
RUN pip install --no-cache-dir /app/libs

# Copy event_consumer code
COPY ./event_consumer /app

# Install event_consumer dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Non-root, with a fixed uid: a volume keeps the owner it was chowned to,
# so the number must not change between builds. 10001 is clear of any
# account the base image or the host is likely to have.
RUN useradd --uid 10001 --create-home appuser
USER appuser

CMD ["python", "main.py"]